APP_NAME=Fixora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://api.tudominio.com
FRONTEND_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fixora
DB_USERNAME=fixora_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=*
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com
FIXORA_TIMEZONE=America/Mexico_City
FIXORA_CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com